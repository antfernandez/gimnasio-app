
# Spec 23 — Pagar plan (Mercado Pago). Solo servidor.
MP_ACCESS_TOKEN_VALINOR=
MP_WEBHOOK_SECRET=

# Spec 83 — Flujo 1: Valinor paga la suscripción del sistema a Antonio (app "Valinor Suscripcion").
# Token: Tus integraciones > la aplicación > Credenciales (prueba o producción).
# Secreto: Webhooks > Configurar notificaciones > Clave secreta.
# Webhook: https://<dominio>/api/mercadopago/webhook?flujo=suscripcion (evento Pagos).
MP_ACCESS_TOKEN_ANTONIO=
MP_WEBHOOK_SECRET_ANTONIO=

# URL pública base (back_urls y notification_url de Mercado Pago). En local, la del túnel (ngrok).
NEXT_PUBLIC_SITE_URL=

# Spec 65 — Secreto del header x-revalidate-secret de /api/revalidate-sitio (también en Vercel).
# Generar con: openssl rand -hex 32
REVALIDATE_SECRET=

# Spec 66 — Modo prueba de pagos (sólo demos). En producción (VERCEL_ENV=production) se
# necesitan AMBAS variables; quitarlas al integrar Mercado Pago real.
MP_MODO_PRUEBA=
MP_MODO_PRUEBA_PRODUCCION=
