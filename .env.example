
# Spec 23 — Pagar plan (Mercado Pago). Solo servidor.
MP_ACCESS_TOKEN_VALINOR=
MP_WEBHOOK_SECRET=

# Spec 23 — Pagar plan, flujo B (suscripción al sistema; cuenta de Antonio Fernandez).
